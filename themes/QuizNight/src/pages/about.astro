---
import Layout from '@layouts/Layout.astro';
import { AdSlot } from '@components/molecules/AdSlot';

const pageTitle = 'About Us - LogicLeague';
const pageDescription = 'Meet the team behind LogicLeague - passionate experts dedicated to creating the world\'s best brain games, quizzes, and logic puzzles.';

// Team members
const team = [
  {
    name: 'Dr. Emma Richardson',
    role: 'Chief Quiz Architect',
    languages: ['English', 'Spanish', 'French'],
    bio: 'With a PhD in Educational Psychology and 12 years of experience in game design, Emma leads our quiz creation team. Her innovative approach combines cognitive science with entertainment, ensuring every puzzle challenges your mind while keeping you engaged. Emma has designed over 5,000 quizzes that have been played by millions worldwide.',
    expertise: ['Logic Puzzle Design', 'Educational Gaming', 'Cognitive Science'],
    imageUrl: '/team/emma-richardson.jpg', // Placeholder
    linkedin: '#',
    twitter: '#'
  },
  {
    name: 'Marcus Chen',
    role: 'Lead Content Strategist',
    languages: ['English', 'Mandarin', 'Japanese'],
    bio: 'A former competitive quiz champion with victories in national trivia tournaments across three continents, Marcus brings unparalleled expertise in content curation. His meticulous attention to detail and vast knowledge base ensure every fact is verified and every question is perfectly balanced for difficulty and engagement.',
    expertise: ['Trivia Curation', 'Difficulty Balancing', 'Competitive Gaming'],
    imageUrl: '/team/marcus-chen.jpg', // Placeholder
    linkedin: '#',
    twitter: '#'
  },
  {
    name: 'Sofia Kowalski',
    role: 'Community & Engagement Director',
    languages: ['English', 'Polish', 'German', 'Italian'],
    bio: 'Sofia\'s background in gamification and user experience design has revolutionized how players interact with LogicLeague. With expertise spanning four languages and cultures, she crafts experiences that resonate globally. Her community-first approach has built a thriving ecosystem of over 2 million active players who return daily.',
    expertise: ['Gamification', 'UX Design', 'Community Building'],
    imageUrl: '/team/sofia-kowalski.jpg', // Placeholder
    linkedin: '#',
    twitter: '#'
  }
];

// Featured quizzes for carousel
const featuredQuizzes = [
  {
    id: '1',
    title: 'World Capitals Challenge',
    category: 'Geography',
    difficulty: 'medium',
    thumbnail: '🌍',
    plays: 15420,
    rating: 4.8
  },
  {
    id: '2',
    title: 'Math Masters: Speed Challenge',
    category: 'Mathematics',
    difficulty: 'hard',
    thumbnail: '🔢',
    plays: 12350,
    rating: 4.9
  },
  {
    id: '3',
    title: 'Movie Trivia Madness',
    category: 'Entertainment',
    difficulty: 'easy',
    thumbnail: '🎬',
    plays: 18900,
    rating: 4.7
  },
  {
    id: '4',
    title: 'Science Facts Challenge',
    category: 'Science',
    difficulty: 'medium',
    thumbnail: '🔬',
    plays: 10200,
    rating: 4.6
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-600 via-secondary-600 to-accent-600 text-white py-20 sm:py-32 overflow-hidden">
    <!-- Animated background elements -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-10 w-64 h-64 bg-white rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-white rounded-full blur-3xl animate-float-delayed"></div>
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mb-6 animate-slide-up">
          About <span class="text-accent-300">LogicLeague</span>
        </h1>
        <p class="text-xl sm:text-2xl text-white/90 mb-8 leading-relaxed animate-slide-up-delayed">
          We're on a mission to make learning fun, one brain-teasing puzzle at a time.
        </p>
        <div class="flex flex-wrap justify-center gap-8 text-left max-w-3xl mx-auto">
          <div class="flex items-start gap-3">
            <span class="text-3xl">🎯</span>
            <div>
              <p class="font-bold text-lg">10,000+</p>
              <p class="text-white/80 text-sm">Expert-Crafted Quizzes</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-3xl">👥</span>
            <div>
              <p class="font-bold text-lg">2M+</p>
              <p class="text-white/80 text-sm">Active Players</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-3xl">🌍</span>
            <div>
              <p class="font-bold text-lg">150+</p>
              <p class="text-white/80 text-sm">Countries Worldwide</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-display font-bold text-dark-900 mb-6">
            Our Mission
          </h2>
          <p class="text-lg text-dark-700 leading-relaxed">
            At LogicLeague, we believe that learning should be an adventure. Our team of expert quiz designers, content creators, and gamification specialists work tirelessly to craft engaging brain teasers that challenge your mind while delivering pure entertainment. Every quiz is meticulously researched, fact-checked, and optimized to provide the perfect balance of difficulty and fun.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-8 mt-16">
          <div class="text-center p-6 bg-primary-50 rounded-2xl">
            <div class="text-5xl mb-4">🏆</div>
            <h3 class="font-bold text-xl text-dark-900 mb-2">Quality First</h3>
            <p class="text-dark-600">Every question is crafted by experts and verified for accuracy</p>
          </div>
          <div class="text-center p-6 bg-secondary-50 rounded-2xl">
            <div class="text-5xl mb-4">🎮</div>
            <h3 class="font-bold text-xl text-dark-900 mb-2">Engaging Content</h3>
            <p class="text-dark-600">Designed to be addictive, educational, and endlessly entertaining</p>
          </div>
          <div class="text-center p-6 bg-accent-50 rounded-2xl">
            <div class="text-5xl mb-4">🌟</div>
            <h3 class="font-bold text-xl text-dark-900 mb-2">Community Driven</h3>
            <p class="text-dark-600">Built with feedback from millions of passionate players</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ad Section -->
  <section class="py-8 bg-dark-50">
    <div class="container-custom flex justify-center">
      <AdSlot client:visible format="leaderboard" slotId="about-page-top" />
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-16 sm:py-24 bg-gradient-to-br from-dark-50 to-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-dark-900 mb-4">
          Meet Our Team
        </h2>
        <p class="text-lg text-dark-600 max-w-2xl mx-auto">
          The brilliant minds behind LogicLeague's world-class quizzes and brain games
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {team.map((member) => (
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow duration-300 group">
            {/* Photo Placeholder */}
            <div class="relative h-80 bg-gradient-to-br from-primary-200 via-secondary-200 to-accent-200 overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="text-9xl opacity-20 group-hover:scale-110 transition-transform duration-500">
                  👤
                </div>
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900/80 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <h3 class="text-2xl font-display font-bold text-white mb-1">
                  {member.name}
                </h3>
                <p class="text-accent-300 font-semibold mb-2">{member.role}</p>
                <div class="flex flex-wrap gap-2">
                  {member.languages.map((lang) => (
                    <span class="px-2 py-1 bg-white/20 backdrop-blur-sm rounded-full text-xs text-white">
                      {lang}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            {/* Bio Content */}
            <div class="p-6">
              <p class="text-dark-700 leading-relaxed mb-6">
                {member.bio}
              </p>

              {/* Expertise Tags */}
              <div class="mb-6">
                <p class="text-xs font-bold text-dark-500 uppercase tracking-wider mb-2">Expertise</p>
                <div class="flex flex-wrap gap-2">
                  {member.expertise.map((skill) => (
                    <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-xs font-medium">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>

              {/* Social Links */}
              <div class="flex gap-3 pt-4 border-t border-dark-100">
                <a
                  href={member.linkedin}
                  class="flex items-center justify-center w-10 h-10 rounded-full bg-dark-100 hover:bg-primary-600 hover:text-white transition-colors"
                  aria-label={`${member.name} on LinkedIn`}
                >
                  <span class="text-sm">💼</span>
                </a>
                <a
                  href={member.twitter}
                  class="flex items-center justify-center w-10 h-10 rounded-full bg-dark-100 hover:bg-secondary-600 hover:text-white transition-colors"
                  aria-label={`${member.name} on Twitter`}
                >
                  <span class="text-sm">🐦</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ad Section -->
  <section class="py-8 bg-white">
    <div class="container-custom flex justify-center">
      <AdSlot client:visible format="banner" slotId="about-page-mid" />
    </div>
  </section>

  <!-- Featured Quizzes Carousel -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-dark-900 mb-4">
          Try Our Popular Quizzes
        </h2>
        <p class="text-lg text-dark-600">
          Experience the quality our team delivers, one quiz at a time
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
        {featuredQuizzes.map((quiz) => (
          <a
            href={`/quizzes/${quiz.id}`}
            class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border-2 border-transparent hover:border-primary-300 transform hover:-translate-y-1"
          >
            <div class="p-6">
              <div class="text-6xl mb-4 text-center group-hover:scale-110 transition-transform">
                {quiz.thumbnail}
              </div>
              <h3 class="text-lg font-bold text-dark-900 mb-2 group-hover:text-primary-600 transition-colors">
                {quiz.title}
              </h3>
              <div class="flex items-center justify-between text-sm mb-4">
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full font-medium">
                  {quiz.category}
                </span>
                <span class={
                  quiz.difficulty === 'easy' ? 'text-green-600 font-semibold' :
                  quiz.difficulty === 'medium' ? 'text-yellow-600 font-semibold' :
                  'text-red-600 font-semibold'
                }>
                  {quiz.difficulty}
                </span>
              </div>
              <div class="flex items-center justify-between text-xs text-dark-600">
                <span>⭐ {quiz.rating}</span>
                <span>👥 {quiz.plays.toLocaleString()} plays</span>
              </div>
            </div>
            <div class="px-6 pb-6">
              <div class="w-full py-2 bg-primary-600 group-hover:bg-primary-700 text-white text-center rounded-lg font-semibold transition-colors">
                Play Now →
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <a
          href="/quizzes"
          class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-primary-600 to-secondary-600 hover:from-primary-700 hover:to-secondary-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all"
        >
          <span>Explore All Quizzes</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 sm:py-24 bg-gradient-to-br from-primary-600 via-secondary-600 to-accent-600 text-white relative overflow-hidden">
    <!-- Animated background -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-white rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-white rounded-full blur-3xl animate-float-delayed"></div>
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-5xl font-display font-bold mb-6">
          Ready to Challenge Your Brain?
        </h2>
        <p class="text-xl text-white/90 mb-8 leading-relaxed">
          Join over 2 million players worldwide and start your journey to becoming a quiz master today!
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/register"
            class="px-8 py-4 bg-white text-primary-600 font-bold rounded-xl shadow-lg hover:shadow-2xl hover:scale-105 transition-all"
          >
            Create Free Account
          </a>
          <a
            href="/quizzes"
            class="px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white text-white font-bold rounded-xl hover:bg-white/20 transition-all"
          >
            Browse Quizzes
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-display font-bold text-dark-900 mb-4">
            Get In Touch
          </h2>
          <p class="text-lg text-dark-600">
            Have questions, suggestions, or just want to say hi? We'd love to hear from you!
          </p>
        </div>

        <div class="bg-gradient-to-br from-primary-50 to-secondary-50 rounded-3xl shadow-xl p-8 sm:p-12">
          <form class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-semibold text-dark-900 mb-2">
                  Your Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 bg-white border-2 border-dark-200 rounded-xl focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all"
                  placeholder="John Doe"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-dark-900 mb-2">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-white border-2 border-dark-200 rounded-xl focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all"
                  placeholder="john@example.com"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-dark-900 mb-2">
                Subject *
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 bg-white border-2 border-dark-200 rounded-xl focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all"
                placeholder="What's this about?"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-dark-900 mb-2">
                Message *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 bg-white border-2 border-dark-200 rounded-xl focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all resize-none"
                placeholder="Tell us what's on your mind..."
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="newsletter"
                name="newsletter"
                class="mt-1 w-5 h-5 text-primary-600 border-dark-300 rounded focus:ring-2 focus:ring-primary-200"
              />
              <label for="newsletter" class="text-sm text-dark-700">
                I'd like to receive updates about new quizzes and features
              </label>
            </div>

            <button
              type="submit"
              class="w-full px-8 py-4 bg-gradient-to-r from-primary-600 to-secondary-600 hover:from-primary-700 hover:to-secondary-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all"
            >
              Send Message
            </button>
          </form>

          <div class="mt-8 pt-8 border-t border-dark-200">
            <div class="flex flex-wrap justify-center gap-8 text-sm text-dark-700">
              <div class="flex items-center gap-2">
                <span class="text-xl">📧</span>
                <a href="mailto:hello@logicleague.com" class="hover:text-primary-600 transition-colors">
                  hello@logicleague.com
                </a>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xl">💬</span>
                <span>Response within 24 hours</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Ad -->
  <section class="py-8 bg-dark-50">
    <div class="container-custom flex justify-center">
      <AdSlot client:visible format="leaderboard" slotId="about-page-bottom" />
    </div>
  </section>
</Layout>
