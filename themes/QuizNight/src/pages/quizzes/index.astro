    title: 'Quick Riddles for Kids',
    description: 'Fun and easy riddles perfect for younger minds.',
    category: 'riddles',
    difficulty: 'easy',
    questionsCount: 10,
    timeLimit: 5,
    thumbnail: '🎈',
    plays: 1830,
    rating: 4.4,
  },
  {
    id: '7',
    title: 'Daily Mini Crossword',
    description: 'Quick 5x5 crossword puzzle to start your day.',
    category: 'crossword',
    difficulty: 'easy',
