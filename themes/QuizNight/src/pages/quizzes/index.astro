---

<BaseLayout>
  <Header client:load />

  <main class="pt-20 min-h-screen bg-gradient-to-b from-white to-dark-50">
    <!-- Page Header -->
    <section class="py-12 sm:py-16 bg-gradient-to-br from-primary-600 to-secondary-500 text-white">
      <div class="container-custom">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mb-4">
          All Quizzes
        </h1>
        <p class="text-lg sm:text-xl text-white/90 max-w-2xl">
          Explore our complete collection of brain-teasing quizzes, puzzles, and challenges. Find your next favorite game!
        </p>
      </div>
    </section>

    <div class="container-custom py-12">
      <!-- Search and Filters -->
      <div class="mb-8">
        <SearchBar client:load placeholder="Search quizzes..." />

        <!-- Filter buttons -->
        <div class="flex flex-wrap gap-3 mt-6">
          <button class="px-4 py-2 rounded-lg bg-primary-600 text-white font-semibold text-sm hover:bg-primary-700 transition-colors">
            All
          </button>
          <button class="px-4 py-2 rounded-lg bg-white border-2 border-dark-200 text-dark-700 font-semibold text-sm hover:border-primary-300 hover:text-primary-600 transition-colors">
            Trivia
          </button>
          <button class="px-4 py-2 rounded-lg bg-white border-2 border-dark-200 text-dark-700 font-semibold text-sm hover:border-primary-300 hover:text-primary-600 transition-colors">
            Riddles
          </button>
          <button class="px-4 py-2 rounded-lg bg-white border-2 border-dark-200 text-dark-700 font-semibold text-sm hover:border-primary-300 hover:text-primary-600 transition-colors">
            Logic
          </button>
          <button class="px-4 py-2 rounded-lg bg-white border-2 border-dark-200 text-dark-700 font-semibold text-sm hover:border-primary-300 hover:text-primary-600 transition-colors">
            Crosswords
          </button>
        </div>
      </div>

      <!-- Top Banner Ad -->
      <div class="mb-12 flex justify-center">
        <AdSlot client:visible format="leaderboard" slotId="quiz-grid-top-banner" />
      </div>

      <!-- Quiz Grid with Integrated Ads -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allQuizzes.map((quiz, index) => (
          <>
            <QuizCard
              client:visible
              id={quiz.id}
              title={quiz.title}
              description={quiz.description}
              category={quiz.category}
              difficulty={quiz.difficulty}
              questionsCount={quiz.questionsCount}
              timeLimit={quiz.timeLimit}
              thumbnail={quiz.thumbnail}
              plays={quiz.plays}
              rating={quiz.rating}
            />

            <!-- Insert rectangle ad after every 6 quizzes -->
            {(index + 1) % 6 === 0 && (
              <div class="md:col-span-2 lg:col-span-3 flex justify-center py-6">
                <AdSlot client:visible format="banner" slotId={`quiz-grid-mid-${index}`} />
              </div>
            )}
          </>
        ))}
      </div>

      <!-- Bottom Banner Ad -->
      <div class="mt-12 flex justify-center">
        <AdSlot client:visible format="leaderboard" slotId="quiz-grid-bottom-banner" />
      </div>

      <!-- Pagination -->
      <div class="flex justify-center items-center gap-2 mt-12">
        <button class="px-4 py-2 rounded-lg bg-dark-100 text-dark-400 font-semibold text-sm cursor-not-allowed">
          Previous
        </button>
        <button class="px-4 py-2 rounded-lg bg-primary-600 text-white font-semibold text-sm">
          1
        </button>
        <button class="px-4 py-2 rounded-lg bg-white border-2 border-dark-200 text-dark-700 font-semibold text-sm hover:border-primary-300 hover:text-primary-600 transition-colors">
          2
        </button>
        <button class="px-4 py-2 rounded-lg bg-white border-2 border-dark-200 text-dark-700 font-semibold text-sm hover:border-primary-300 hover:text-primary-600 transition-colors">
          3
        </button>
        <button class="px-4 py-2 rounded-lg bg-white border-2 border-dark-200 text-dark-700 font-semibold text-sm hover:border-primary-300 hover:text-primary-600 transition-colors">
          Next
        </button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Smooth transitions */
  button {
    transition: all 0.2s ease;
  }
</style>
