    thumbnail: '📺',
    plays: 1450,
    rating: 4.5,
  },
  {
    id: '9',
    title: 'History Masters Quiz',
    description: 'Journey through time with questions spanning ancient to modern history.',
    category: 'trivia',
    difficulty: 'hard',
    questionsCount: 30,
    timeLimit: 18,
    thumbnail: '📚',
    plays: 820,
    rating: 4.8,
  },
  {
    id: '10',
    title: 'Sports Legends Trivia',
    description: 'Test your sports knowledge across football, basketball, and more!',
    category: 'trivia',
