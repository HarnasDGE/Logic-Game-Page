    title: 'Quick Riddles for Kids',
    description: 'Fun and easy riddles perfect for younger minds. Educational and entertaining, these puzzles help develop critical thinking skills while having fun!',
    category: 'Kids',
    difficulty: 'easy' as const,
    questionsCount: 10,
    timeLimit: 5,
    thumbnail: '🎈',
    plays: 1830,
    rating: 4.4,
