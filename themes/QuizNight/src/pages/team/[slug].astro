        description: 'Industry-leading fact-checking accuracy across all content',
        icon: '✓'
      },
      {
        title: 'Polyglot Expert',
        description: 'Fluent in 3 languages, conversational in 2 more',
        icon: '🌏'
      }
    ],
    stats: {
