    ],
    stats: {
      quizzesCreated: 2156,
      totalPlays: 6800000,
      avgRating: 4.9,
      yearsExperience: 8
    },
    socialLinks: {
      linkedin: '#',
      twitter: '#',
      email: 'sofia@logicleague.com'
    },
    featuredQuizzes: [
      {
        id: '3',
        title: 'Movie Trivia Madness',
        category: 'Entertainment',
        difficulty: 'easy',
        plays: 18900,
        rating: 4.7,
        thumbnail: '🎬'
      },
      {
        id: '10',
        title: 'What\'s Your Learning Style?',
        category: 'Personality',
        difficulty: 'easy',
        plays: 42000,
        rating: 4.9,
        thumbnail: '📚'
      },
      {
        id: '14',
        title: 'European Cultures Quiz',
